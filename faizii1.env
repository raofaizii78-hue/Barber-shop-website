# Copy this file to faizii1.env.local and add your private credentials there.
PORT=3000
# Leave empty for a generated local key; use a private random value for deployment.
JWT_SECRET=change_this_to_a_long_random_secret
# SMTP sender account. For Gmail, use a Google App Password (not your login password).
EMAIL_USER=yourshop@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
# Gmail SMTP defaults; update these for your email provider if needed.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
# This email becomes ADMIN (can see/edit/delete all bookings)
ADMIN_EMAIL=yourshop@gmail.com
# Supabase REST endpoint used for appointment persistence.
SUPABASE_REST_URL=https://igowvkdyyxaczkhlgkie.supabase.co/rest/v1
# Server-only service-role key. Set this in faizii1.env.local; never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
